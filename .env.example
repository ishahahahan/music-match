# Spotify Developer Dashboard credentials (rotate if ever exposed; never commit .env)
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# MongoDB Atlas connection string, or local: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=musicmatch

# First-party API tokens — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-long-random-string

# Allowed browser origin (JSON array)
CORS_ORIGINS=["http://localhost:3000"]
