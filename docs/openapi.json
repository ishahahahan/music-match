{
  "openapi": "3.1.0",
  "info": {
    "title": "MusicMatch API",
    "description": "Mobile-ready REST API: login, auto-profiles, compatibility matching. Every /api/v1 response is wrapped in a uniform envelope: success bodies are {data, request_id, timestamp}; errors are {error: {code, message, details?}, request_id, timestamp}. Authenticate with Authorization: Bearer <JWT> \u2014 tokens never appear in URLs.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service liveness",
        "operationId": "health_api_v1_health_get",
