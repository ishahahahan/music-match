    "/api/v1/matches/{target_id}/blend": {
      "post": {
        "tags": [
          "matches"
        ],
        "summary": "Create the Blend playlist",
        "operationId": "blend_api_v1_matches__target_id__blend_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
