        ],
        "summary": "Public profile by id",
        "operationId": "public_profile_api_v1_users__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "users/{spotify_id}",
              "title": "User Id"
            },
            "description": "users/{spotify_id}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
