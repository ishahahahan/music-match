  "components": {
    "schemas": {
      "BlendRequest": {
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "title": "Access Token"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "BlendRequest"
      },
      "BlendResult": {
        "properties": {
          "pair_id": {
            "type": "string",
            "title": "Pair Id"
          },
          "playlist_id": {
            "type": "string",
            "title": "Playlist Id"
          },
          "playlist_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Playlist Url"
          },
          "track_count": {
            "type": "integer",
            "title": "Track Count"
          }
        },
        "type": "object",
        "required": [
          "pair_id",
          "playlist_id",
          "track_count"
        ],
        "title": "BlendResult"
      },
      "ChatStartersOut": {
        "properties": {
          "pair_id": {
            "type": "string",
            "title": "Pair Id"
          },
          "starters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Starters"
          }
        },
        "type": "object",
        "required": [
          "pair_id",
          "starters"
        ],
        "title": "ChatStartersOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Headline": {
        "properties": {
          "top_genre": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top Genre"
          },
          "top_artist": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top Artist"
          }
        },
        "type": "object",
        "title": "Headline",
        "description": "One-line taste preview shown on a candidate card."
      },
      "MatchCandidate": {
        "properties": {
          "pair_id": {
            "type": "string",
            "title": "Pair Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "score": {
            "$ref": "#/components/schemas/ScoreBreakdown"
          },
          "headline": {
            "$ref": "#/components/schemas/Headline"
          }
        },
        "type": "object",
        "required": [
          "pair_id",
          "user_id",
          "display_name",
          "score",
          "headline"
        ],
        "title": "MatchCandidate"
      },
      "MatchesPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MatchCandidate"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "items",
          "limit"
        ],
        "title": "MatchesPage",
        "description": "Cursor-paginated ranked candidates (Phase 5 pagination contract)."
      },
      "ProfileRead": {
        "properties": {
          "spotify_id": {
            "type": "string",
            "title": "Spotify Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "top_genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Top Genres"
          },
          "genre_fingerprint": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Genre Fingerprint"
          },
          "top_artists": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Top Artists"
          },
          "top_tracks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Top Tracks"
          },
          "audio_fingerprint": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Audio Fingerprint"
          },
          "music_blurb": {
            "type": "string",
            "title": "Music Blurb",
            "default": ""
          },
          "discoverable": {
            "type": "boolean",
            "title": "Discoverable",
            "default": true
          },
          "synced_track_count": {
            "type": "integer",
            "title": "Synced Track Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "spotify_id",
          "display_name"
        ],
        "title": "ProfileRead",
        "description": "Auto-generated profile returned by GET /me/profile (Phase 3)."
      },
      "ProfileVisibilityIn": {
        "properties": {
          "discoverable": {
            "type": "boolean",
            "title": "Discoverable"
          }
        },
        "type": "object",
        "required": [
          "discoverable"
        ],
        "title": "ProfileVisibilityIn",
        "description": "Profile control: discoverable (shown in matching) vs hidden."
      },
      "RecomputeResult": {
        "properties": {
          "scores_written": {
            "type": "integer",
            "title": "Scores Written"
          }
        },
        "type": "object",
        "required": [
          "scores_written"
        ],
        "title": "RecomputeResult"
      },
      "ScoreBreakdown": {
        "properties": {
          "genre": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Genre"
          },
          "artist": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Artist"
          },
          "audio": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Audio"
          },
          "overall": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Overall"
          }
        },
        "type": "object",
        "required": [
          "genre",
          "artist",
          "audio",
          "overall"
        ],
        "title": "ScoreBreakdown",
        "description": "All three components \u2014 no more silent 0.40 cap."
      },
      "SelfAction": {
        "properties": {
          "unmatched": {
            "type": "boolean",
            "title": "Unmatched"
          },
          "pair_id": {
            "type": "string",
            "title": "Pair Id"
          }
        },
        "type": "object",
        "required": [
          "unmatched",
          "pair_id"
        ],
        "title": "SelfAction",
        "description": "Response for DELETE /matches/{user_id}."
      },
      "SwipeResult": {
        "properties": {
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "like",
              "pass"
            ],
            "title": "Action"
          },
          "pair_id": {
            "type": "string",
            "title": "Pair Id"
          },
          "match_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pending",
                  "liked",
                  "matched",
                  "passed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Status"
          }
        },
        "type": "object",
        "required": [
          "target_id",
          "action",
          "pair_id"
        ],
        "title": "SwipeResult"
      },
      "SyncStartRequest": {
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "title": "Access Token"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "SyncStartRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
